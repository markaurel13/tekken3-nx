+    READ_MARK(MIN3(u0,u1,u2),MAX3(u0,u1,u2),MIN3(v0,v1,v2),MAX3(v0,v1,v2),clut_x,clut_y,texpage);
     WATCH_TRI(x0, y0, x1, y1, x2, y2); g_b->draw_textured_triangle(x0, y0, u0, v0, x1, y1, u1, v1, x2, y2, u2, v2,
                                 clut_x, clut_y, texpage);
 }
