diff --git a/src/tekken3_cine_scene.c b/src/tekken3_cine_scene.c
index 2246d97..f22c702 100644
--- a/src/tekken3_cine_scene.c
+++ b/src/tekken3_cine_scene.c
@@ -134,8 +134,26 @@ static void black(void) {
 
 /* Every frame (src/tekken3_embu_scenes.c). */
 static void test_tick(void);
+/* TEKKEN3_CINE_SCENE_READ_MAP=file: the VRAM a scene reads while it plays,
+ * by 16 x 16 blocks (t texels, c CLUT, b both), from the renderer's
+ * gr_read_map (the other half of tools/cine_read_map.patch). */
+static void read_map(void) {
+    extern unsigned char gr_read_map[32][64]; extern int gr_read_map_on;
+    extern int tekken3_cine_engine_frame(void);
+    static int was; const char *out=getenv("TEKKEN3_CINE_SCENE_READ_MAP");
+    int on=out && stage==PLAYING && tekken3_cine_engine_frame()>=0;
+    if(on && !was) { memset(gr_read_map,0,sizeof gr_read_map); gr_read_map_on=1; }
+    if(!on && was) {
+        gr_read_map_on=0;
+        FILE *f=fopen(out,"w");
+        if(f) { for(int y=0;y<32;y++){ for(int x=0;x<64;x++) fputc(".tcb"[gr_read_map[y][x]&3],f); fputc(10,f);} fclose(f); }
+        fprintf(stderr,"Cine scene: read map to %s%c",out,10);
+    }
+    was=on;
+}
 void tekken3_cine_scene_tick(void) {
     test_tick();
+    read_map();
     if(stage!=LOADING) return;
     unsigned state=psx_mod_read_half(STATE),phase=psx_mod_read_half(PHASE);
     write_scene();
