 }
+/* LOCAL PROBE (cine-scene, not committed): VRAM blocks of 16x16 read as
+ * texels (1) or CLUT (2) while gr_read_map_on. */
+unsigned char gr_read_map[32][64]; int gr_read_map_on;
+static void read_mark(int x0,int y0,int x1,int y1,unsigned char bit){
+    if(x0<0)x0=0; if(y0<0)y0=0; if(x1>1023)x1=1023; if(y1>511)y1=511;
+    for(int y=y0/16;y<=y1/16;y++)for(int x=x0/16;x<=x1/16;x++)gr_read_map[y][x]|=bit;
+}
+static void READ_MARK(int umin,int umax,int vmin,int vmax,uint16_t cx,uint16_t cy,uint16_t tp){
+    if(!gr_read_map_on)return;
+    int bx=(tp&15)*64, by=((tp>>4)&1)*256, depth=(tp>>7)&3, div=depth==0?4:depth==1?2:1;
+    read_mark(bx+umin/div,by+vmin,bx+umax/div,by+vmax,1);
+    if(depth<2)read_mark(cx,cy,cx+(depth==0?15:255),cy,2);
+}
+#define MIN3(a,b,c) ((a)<(b)?((a)<(c)?(a):(c)):((b)<(c)?(b):(c)))
+#define MAX3(a,b,c) ((a)>(b)?((a)>(c)?(a):(c)):((b)>(c)?(b):(c)))
